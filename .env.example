# Local development only. Run ./bin/dev init to generate .env with random passwords.
COMPOSE_PROJECT_NAME=maison-rivage
WORDPRESS_PORT=8080
MAILPIT_PORT=8025
WP_URL=http://localhost:8080
# Optional private Tailscale Serve HTTPS origin; no trailing path.
RIVAGE_PREVIEW_URL=
DB_NAME=maison_rivage
DB_USER=maison_rivage
DB_PASSWORD=replace-with-local-random-password
DB_ROOT_PASSWORD=replace-with-another-local-random-password
WP_ADMIN_USER=rivage_admin
WP_ADMIN_PASSWORD=replace-with-local-random-password
WP_ADMIN_EMAIL=admin@maison-rivage.test
